// ============================================================
// Student–Company Freelance Job Posting Platform
// Prisma Schema
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  student
  company_member
  company_admin
  platform_admin
  super_admin
}

enum AuthProvider {
  microsoft
  email_password
  magic_link
}

enum PostingStatus {
  draft
  open
  closed
  archived
}

enum PostingType {
  freelance
  internship
  part_time
  contract
}

enum WorkMode {
  remote
  on_site
  hybrid
}

enum CompensationType {
  paid
  unpaid
  academic_credit
  negotiable
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum ApplicationStatus {
  submitted
  reviewing
  shortlisted
  accepted
  rejected
  withdrawn
}

enum MemberRole {
  admin
  member
}

enum NotificationType {
  application_submitted
  application_shortlisted
  application_accepted
  application_rejected
  company_verified
  posting_status_changed
  admin_action
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?      @map("password_hash")
  authProvider AuthProvider @map("auth_provider")
  microsoftOid String?      @unique @map("microsoft_oid")
  tenantId     String?      @map("tenant_id")
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  displayName  String       @map("display_name")
  avatarUrl    String?      @map("avatar_url")
  role         Role
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  studentProfile     StudentProfile?
  companyMemberships CompanyMember[]
  applications       Application[]
  notifications      Notification[]
  auditLogs          AuditLog[]      @relation("ActorAuditLogs")
  postingsCreated    Posting[]       @relation("PostingCreator")

  @@map("users")
}

// ============================================================
// STUDENT PROFILE
// ============================================================

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  schoolName     String?  @map("school_name")
  programName    String?  @map("program_name")
  graduationYear Int?     @map("graduation_year")
  bio            String?
  location       String?
  skills         String[]
  portfolioUrl   String?  @map("portfolio_url")
  linkedinUrl    String?  @map("linkedin_url")
  githubUrl      String?  @map("github_url")
  resumeUrl      String?  @map("resume_url")
  availability   String?
  hourlyRate     Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// ============================================================
// COMPANIES
// ============================================================

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?  @map("logo_url")
  website     String?
  industry    String?
  companySize String?  @map("company_size")
  description String?
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members  CompanyMember[]
  postings Posting[]

  @@map("companies")
}

model CompanyMember {
  id         String     @id @default(cuid())
  companyId  String     @map("company_id")
  userId     String     @map("user_id")
  memberRole MemberRole @default(member) @map("member_role")
  invitedBy  String?    @map("invited_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

// ============================================================
// POSTINGS
// ============================================================

model Posting {
  id                  String           @id @default(cuid())
  companyId           String           @map("company_id")
  createdBy           String           @map("created_by")
  title               String
  slug                String           @unique
  shortDescription    String?          @map("short_description")
  description         String?
  postingType         PostingType      @map("posting_type")
  workMode            WorkMode         @map("work_mode")
  duration            String?
  compensationType    CompensationType @map("compensation_type")
  budgetMin           Decimal?         @map("budget_min") @db.Decimal(10, 2)
  budgetMax           Decimal?         @map("budget_max") @db.Decimal(10, 2)
  currency            String?          @default("CAD")
  requiredSkills      String[]         @map("required_skills")
  experienceLevel     ExperienceLevel  @map("experience_level")
  applicationDeadline DateTime?        @map("application_deadline")
  status              PostingStatus    @default(draft)
  publishedAt         DateTime?        @map("published_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator      User          @relation("PostingCreator", fields: [createdBy], references: [id])
  applications Application[]

  @@map("postings")
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id            String            @id @default(cuid())
  postingId     String            @map("posting_id")
  studentUserId String            @map("student_user_id")
  coverLetter   String?           @map("cover_letter")
  resumeUrl     String?           @map("resume_url")
  proposedRate  Decimal?          @map("proposed_rate") @db.Decimal(10, 2)
  notes         String?
  status        ApplicationStatus @default(submitted)
  appliedAt     DateTime          @default(now()) @map("applied_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  posting Posting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([postingId, studentUserId])
  @@map("applications")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  actionType   String   @map("action_type")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
